# Copier vers .env.local et remplir. Ne jamais commiter .env.local.

# TMDB — https://www.themoviedb.org/settings/api, champ « jeton d'accès en lecture »
# (auth v4). C'est le seul identifiant TMDB utilisé : le client envoie un en-tête
# Bearer et n'a jamais besoin de la clé d'API v3.
TMDB_READ_TOKEN=

# Neon Postgres — injecté par l'intégration Vercel
DATABASE_URL=

# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Protège /api/cron/ingest — générer avec : openssl rand -hex 32
CRON_SECRET=
